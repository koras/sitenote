{
  "manifest_version": 3,
  "name": "Заметки по сайтам",
  "description": "Кнопки заметок поверх сайта справа по центру.",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["notes-core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
